                    <!-- Left Page: Story Reading Passage (Second in DOM so in RTL it displays on the left side) -->
                    <div class="story-page-content">
                        <div>
                            <div class="story-header">
                                <h3 class="story-page-title" id="storyTitle">Chapter 1: The Beating Heart of History</h3>
                                <button type="button" class="audio-btn" onclick="speakCurrentStoryPage()" title="استمع للنطق">🔊</button>
                            </div>
                            <div class="story-paragraph" id="storyText">
                                Egypt is a land with a heart that has been beating for thousands of years. We are proud to call it our home. It is a place where the past and the present meet in harmony.
                            </div>
                        </div>

                        <div>
                            <div class="story-translation-box" id="storyTranslation">
                                <span class="translation-tag">💡 الترجمة:</span>
                                مصر أرض ذات قلب ينبض منذ آلاف السنين. نحن فخورون بأن نطلق عليها وطننا وبيتنا. إنها المكان الذي يلتقي فيه الماضي والحاضر في تناغم وانسجام تام.
                            </div>

                            <div class="story-vocab-chips" id="storyVocab">
                                <span class="vocab-chip">beating (ينبض)</span>
                                <span class="vocab-chip">proud (فخور)</span>
                                <span class="vocab-chip">home (وطن)</span>
                                <span class="vocab-chip">harmony (تناغم / انسجام)</span>
                            </div>
                        </div>
