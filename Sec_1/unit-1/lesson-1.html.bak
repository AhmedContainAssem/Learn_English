                { emoji: "🛡️", question: "8. It is the national duty of every citizen to ________ our historical treasures.", options: [{ text: "preserve", isCorrect: true }, { text: "destroy", isCorrect: false }, { text: "damage", isCorrect: false }, { text: "pollute", isCorrect: false }], correctMsg: "رائع! preserve = يحفظ ويصون (+10)", wrongMsg: "يحفظ ويصون تعني preserve." },
                { emoji: "🇪🇬", question: "9. We feel deeply ________ of calling beloved Egypt our home.", options: [{ text: "proud", isCorrect: true }, { text: "pride", isCorrect: false }, { text: "prouder", isCorrect: false }, { text: "proudly", isCorrect: false }], correctMsg: "أحسنت! proud of = فخور بـ (+10)", wrongMsg: "proud هي الصفة (فخور)." },
                { emoji: "🏆", question: "10. Egyptians take immense ________ in the great achievements of their ancestors.", options: [{ text: "pride", isCorrect: true }, { text: "proud", isCorrect: false }, { text: "priding", isCorrect: false }, { text: "proudness", isCorrect: false }], correctMsg: "ممتاز! take pride in = يفتخر بـ (pride اسم) (+10)", wrongMsg: "take pride in تعني يفتخر." },
                { emoji: "🔨", question: "11. Dr. Mona Hassan led a specialist team to ________ parts of the Philae Temple.", options: [{ text: "restore", isCorrect: true }, { text: "demolish", isCorrect: false }, { text: "waste", isCorrect: false }, { text: "forget", isCorrect: false }], correctMsg: "بطل! restore = يرمم ويعيد لحالته الأصلية (+10)", wrongMsg: "يرمم هي restore." },
                { emoji: "📜", question: "12. Hieroglyphs ________ into temple walls were not just art; they recorded history.", options: [{ text: "carved", isCorrect: true }, { text: "cooked", isCorrect: false }, { text: "flown", isCorrect: false }, { text: "sailed", isCorrect: false }], correctMsg: "رائع! carved = نُحتت على الجدران (+10)", wrongMsg: "carved تعني منحوتة." },

                // Accumulative Vocabulary Questions
                { emoji: "📜", question: "13. Ancient Egyptians wrote their sacred records on ________ scrolls.", options: [{ text: "papyrus", isCorrect: true }, { text: "plastic", isCorrect: false }, { text: "rubber", isCorrect: false }, { text: "metal", isCorrect: false }], correctMsg: "أحسنت! papyrus = ورق البردي (+10)", wrongMsg: "ورق البردي هو papyrus." },
                { emoji: "🌾", question: "14. Ships transported sacks of spices and ________ like wheat across Egypt.", options: [{ text: "grain", isCorrect: true }, { text: "petrol", isCorrect: false }, { text: "engines", isCorrect: false }, { text: "factories", isCorrect: false }], correctMsg: "ممتاز! grain = غلال وحبوب (+10)", wrongMsg: "الحبوب والغلال هي grain." },
                { emoji: "🔍", question: "15. An ________ is a specialist who studies ancient human history and monuments.", options: [{ text: "archaeologist", isCorrect: true }, { text: "architect", isCorrect: false }, { text: "astronomer", isCorrect: false }, { text: "accountant", isCorrect: false }], correctMsg: "بطل! archaeologist = عالم آثار (+10)", wrongMsg: "عالم الآثار هو archaeologist." },
                { emoji: "💪", question: "16. Egyptians have a strong ________ to overcome challenges and progress.", options: [{ text: "determination", isCorrect: true }, { text: "hesitation", isCorrect: false }, { text: "carelessness", isCorrect: false }, { text: "laziness", isCorrect: false }], correctMsg: "رائع! determination = عزيمة وإصرار (+10)", wrongMsg: "العزيمة والإصرار هي determination." },
                { emoji: "💡", question: "17. Dr. Mona pointed out that the biggest challenge is a lack of ________ among some youth.", options: [{ text: "awareness", isCorrect: true }, { text: "sunlight", isCorrect: false }, { text: "stones", isCorrect: false }, { text: "temples", isCorrect: false }], correctMsg: "أحسنت! lack of awareness = نقص الوعي (+10)", wrongMsg: "الوعي هو awareness." },
                { emoji: "🌇", question: "18. Rapid ________ development refers to the growth and expansion of modern cities.", options: [{ text: "urban", isCorrect: true }, { text: "rural", isCorrect: false }, { text: "wild", isCorrect: false }, { text: "oceanic", isCorrect: false }], correctMsg: "ممتاز! urban development = تطور وتوسع حضري متعلق بالمدن (+10)", wrongMsg: "حضري متعلق بالمدن هي urban." },
                { emoji: "🤝", question: "19. Every citizen has a role in ________ to the national economy.", options: [{ text: "contributing", isCorrect: true }, { text: "stealing", isCorrect: false }, { text: "ignoring", isCorrect: false }, { text: "preventing", isCorrect: false }], correctMsg: "بطل! contributing to = يساهم في (+10)", wrongMsg: "يساهم في تعني contributing to." },
                { emoji: "🌿", question: "20. Egypt is a unique land where the past and present meet in perfect ________.", options: [{ text: "harmony", isCorrect: true }, { text: "conflict", isCorrect: false }, { text: "argument", isCorrect: false }, { text: "disaster", isCorrect: false }], correctMsg: "رائع! in harmony = في تناغم وانسجام (+10)", wrongMsg: "تناغم وانسجام يعني harmony." },

