                        <div>
                            <span class="tag-badge">Adjective (adj)</span>
                            <div class="word-en">proud</div>
                        </div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('proud. feeling pleased and satisfied because of something good that you, your country, or someone else has done.'); playSound('click');" title="نطق الكلمة والتعريف">🔊</button>
