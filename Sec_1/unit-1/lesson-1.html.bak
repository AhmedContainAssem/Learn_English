        <!-- ======================================================== -->
        <div id="definitions-syn-ant" class="tab-content" style="display: none;">
            <div class="section-title">📚 II. DEFINITIONS, SYNONYMS &amp; ANTONYMS (التعريفات والمترادفات والمتضادات)</div>
            <div class="lesson-desc-display" style="text-align: right; margin-bottom: 24px;">
                💡 <strong>القسم المنهجي الثاني:</strong> التعريفات المنهجية المعتمدة موضع الامتحان، وقوائم المترادفات والمتضادات الشاملة لدرسي 1 و 2 مع النطق الصوتي التفاعلي 🔊.
            </div>

            <!-- 1. Definitions -->
            <h3 class="section-subtitle">1. Definitions (التعريفات المنهجية موضع الامتحان)</h3>
            <div class="cards-grid grid-cards" style="margin-bottom: 32px;">
                <!-- crossroads -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div>
                            <span class="tag-badge">Noun (n)</span>
                            <div class="word-en">crossroads</div>
                        </div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('crossroads. a place where two or more roads meet; it can also mean an important meeting point for people or ideas.'); playSound('click');" title="نطق الكلمة والتعريف">🔊</button>
                    </div>
                    <div class="card-body">
                        <div><strong>المعنى بالعربية:</strong> مُلْتَقَى طُرُق / نُقْطَة تَقَاطُع</div>
                        <div class="simple-explain-box" style="margin-top: 10px;">
                            <strong style="color: var(--accent-primary);">📖 Definition (المفهوم المنهجي):</strong><br>
                            a place where two or more roads meet; it can also mean an important meeting point for people or ideas
                        </div>
                    </div>
                </div>

                <!-- identity -->
                <div class="card" onclick="playSound('click')">
