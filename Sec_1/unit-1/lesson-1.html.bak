    <link rel="stylesheet" href="../../assets/css/storybook.css">
    <link rel="stylesheet" href="../../assets/css/quiz.css">
    <style>
        .study-table-card {
            background: rgba(19, 27, 46, 0.95);
            border: 1px solid rgba(0, 243, 255, 0.2);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 16px;
        }
        .study-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.07);
            flex-wrap: wrap;
            gap: 8px;
        }
        .study-item:last-child {
            border-bottom: none;
        }
        .study-item-en {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--accent-primary);
            direction: ltr;
            text-align: left;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .study-item-ar {
            font-size: 0.95rem;
            color: #cbd5e1;
            font-weight: 600;
        }
        .syn-ant-card {
            background: rgba(19, 27, 46, 0.95);
            border: 1px solid rgba(0, 243, 255, 0.2);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 16px;
        }
        .syn-ant-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 8px;
        }
        .syn-box {
            background: rgba(0, 243, 255, 0.05);
            border-right: 3px solid var(--accent-primary);
            padding: 8px 12px;
            border-radius: 6px;
            margin-bottom: 8px;
        }
        .ant-box {
            background: rgba(255, 183, 3, 0.05);
            border-right: 3px solid var(--accent-orange);
            padding: 8px 12px;
            border-radius: 6px;
        }
        .note-card {
            background: linear-gradient(145deg, rgba(19, 27, 46, 0.95), rgba(15, 23, 42, 0.95));
            border: 1px solid rgba(0, 243, 255, 0.25);
            border-radius: 14px;
            padding: 20px;
            margin-bottom: 22px;
        }
        .note-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 2px solid rgba(0, 243, 255, 0.2);
            padding-bottom: 10px;
            margin-bottom: 14px;
            flex-wrap: wrap;
            gap: 10px;
        }
        .note-title-en {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--accent-primary);
            direction: ltr;
        }
        .note-title-ar {
            font-size: 1.05rem;
            color: #e2e8f0;
            font-weight: 700;
        }
        .dont-mix-box {
            background: rgba(255, 71, 126, 0.08);
            border-right: 4px solid var(--accent-red);
            border-radius: 8px;
            padding: 12px 16px;
            margin-top: 14px;
        }
        .goes-with-box {
            background: rgba(0, 255, 157, 0.08);
            border-right: 4px solid var(--accent-green);
            border-radius: 8px;
            padding: 12px 16px;
            margin-bottom: 12px;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Navigation Back -->
        <div class="page-actions">
            <a href="./index.html" class="back-btn back-home" data-sound-click="click">⬅ العودة لوحدة Egypt's Heritage (Sec 1)</a>
        </div>

        <!-- Teacher Profile & Header -->
        <div class="teacher-profile-header">
            <div class="avatar-wrapper">
                <img src="../../my-photo-profile.webp" alt="Mr. Ahmed Assem" class="teacher-avatar">
            </div>
            <h1 class="teacher-title">Mr. Ahmed Assem</h1>
            <div class="slogan">✨ Easy Peasy Ya Englezeey ✨</div>
            <div class="badges-group" style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 10px;">
                <span class="badge badge-active">Sec 1 (الصف الأول الثانوي)</span>
                <span class="badge badge-gold">📖 SB pages 12 : 16 • Unit 1: Egypt's Heritage</span>
            </div>
            <h2 id="title" class="lesson-title-display">Lessons 1 & 2: Taking Pride in Our Beloved Egypt</h2>
            <p id="description" class="lesson-desc-display">المفردات الأساسية والتراكمية (59 كلمة)، التعريفات والمترادفات والمتضادات، المتلازمات والتعبيرات وحروف الجر، المشتقات ولاحظ الفرق، القراءة التفاعلية المصورة (Storybook)، حوار الدكتورة منى حسن (Dialogue Engine)، واختبار شامل مع محرك الكويز 🎯</p>
        </div>

        <!-- Signature Cyane Center-Node Divider -->
        <div class="cyane-divider" aria-hidden="true"></div>

        <!-- Tabs Navigation Bar -->
        <div class="tabs-container">
            <button class="tab-btn active" onclick="switchTab('vocab', this)">📖 المفردات (59 كلمة)</button>
            <button class="tab-btn" onclick="switchTab('definitions-syn-ant', this)">📚 التعريفات والمترادفات والمتضادات</button>
            <button class="tab-btn" onclick="switchTab('collocations-study', this)">🔗 المتلازمات والتعبيرات وحروف الجر</button>
            <button class="tab-btn" onclick="switchTab('language-notes', this)">💡 المشتقات ودراسة الفروق (لاحظ الفرق)</button>
            <button class="tab-btn" onclick="switchTab('storybook', this)">📚 القراءة التفاعلية (Story Book)</button>
            <button class="tab-btn" onclick="switchTab('dialogue', this)">🗣️ المحادثة التفاعلية (Dialogue Engine)</button>
            <button class="tab-btn" onclick="switchTab('quiz', this)">🎯 اختبار الدرس الشامل (Quiz)</button>
        </div>

        <!-- ========================================== -->
        <!-- Tab 1: Key & Accumulative Vocabulary       -->
        <!-- ========================================== -->
        <div id="vocab" class="tab-content active">
            <!-- Part 1: Key Vocabulary (13 items) -->
            <h3 class="section-subtitle">🌟 المفردات اللغوية الأساسية موضع الامتحان (Key Vocabulary) - 13 كلمة:</h3>
            <div class="grid-cards">
                <!-- 1. civilization -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div>
                            <span class="tag-badge">Noun</span>
                            <div class="word-en">civilization</div>
                        </div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('civilization'); playSound('click');" title="نطق الكلمة">🔊</button>
                    </div>
                    <div class="card-body">
                        <strong>المعنى:</strong> حَضَارَة
                        <div class="simple-explain-box">
                            💡 <strong>التوضيح:</strong> مجتمع بشري متقدم في العلوم والفنون وتنظيم الحكم مثل الحضارة المصرية القديمة.
                        </div>
                    </div>
                </div>

                <!-- 2. crossroads -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div>
                            <span class="tag-badge">Noun</span>
                            <div class="word-en">crossroads</div>
                        </div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('crossroads'); playSound('click');" title="نطق الكلمة">🔊</button>
                    </div>
                    <div class="card-body">
                        <strong>المعنى:</strong> مُلْتَقَى طُرُق / نُقْطَة تَقَاطُع
                        <div class="simple-explain-box">
                            💡 <strong>التوضيح:</strong> المكان الذي تلتقي فيه الطرق المختلفة، ومصر ملتقى قارات العالم.
                        </div>
                    </div>
                </div>

                <!-- 3. crossroads for trade -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div>
                            <span class="tag-badge">Phrase / Noun</span>
                            <div class="word-en">crossroads for trade</div>
                        </div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('crossroads for trade'); playSound('click');" title="نطق العبارة">🔊</button>
                    </div>
                    <div class="card-body">
                        <strong>المعنى:</strong> مُلْتَقَى طُرُقِ التِّجَارَة
                        <div class="simple-explain-box">
                            💡 <strong>التوضيح:</strong> مركز تجاري تلتقي فيه قوافل وسفن التجارة من مختلف البلدان.
                        </div>
                    </div>
                </div>

                <!-- 4. heritage -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div>
                            <span class="tag-badge">Noun</span>
                            <div class="word-en">heritage</div>
                        </div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('heritage'); playSound('click');" title="نطق الكلمة">🔊</button>
                    </div>
                    <div class="card-body">
                        <strong>المعنى:</strong> تُرَاث
                        <div class="simple-explain-box">
                            💡 <strong>التوضيح:</strong> الآثار والتقاليد والثقافة المتوارثة عبر الأجيال من الأجداد.
                        </div>
                    </div>
                </div>

                <!-- 5. identity -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div>
                            <span class="tag-badge">Noun</span>
                            <div class="word-en">identity</div>
                        </div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('identity'); playSound('click');" title="نطق الكلمة">🔊</button>
                    </div>
                    <div class="card-body">
                        <strong>المعنى:</strong> هُوِيَّة
                        <div class="simple-explain-box">
                            💡 <strong>التوضيح:</strong> الخصائص والصفات التي تميز الشخص أو الشعب عن غيره (الهوية الوطنية).
                        </div>
                    </div>
                </div>

                <!-- 6. merchant -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div>
                            <span class="tag-badge">Noun</span>
                            <div class="word-en">merchant</div>
                        </div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('merchant'); playSound('click');" title="نطق الكلمة">🔊</button>
                    </div>
                    <div class="card-body">
                        <strong>المعنى:</strong> تَاجِر
                        <div class="simple-explain-box">
                            💡 <strong>التوضيح:</strong> شخص يشتري ويبيع البضائع بكميات كبيرة في الأسواق.
                        </div>
                    </div>
                </div>

                <!-- 7. monument -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div>
                            <span class="tag-badge">Noun</span>
                            <div class="word-en">monument</div>
                        </div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('monument'); playSound('click');" title="نطق الكلمة">🔊</button>
                    </div>
                    <div class="card-body">
                        <strong>المعنى:</strong> أَثَر (مفرد آثار) / نَصْب تِذْكَارِي
                        <div class="simple-explain-box">
                            💡 <strong>التوضيح:</strong> مبنى أو تمثال تاريخي مهم يُبنى لتخليد ذكرى شخص أو حدث عظيم.
                        </div>
                    </div>
                </div>

                <!-- 8. neighborhood -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div>
                            <span class="tag-badge">Noun</span>
                            <div class="word-en">neighborhood</div>
                        </div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('neighborhood'); playSound('click');" title="نطق الكلمة">🔊</button>
                    </div>
                    <div class="card-body">
                        <strong>المعنى:</strong> حَيّ سَكَنِي / مُجَاوَرَة
                        <div class="simple-explain-box">
                            💡 <strong>التوضيح:</strong> المنطقة أو الحي الذي يعيش فيه الناس ويشتركون في مرافقه.
                        </div>
                    </div>
                </div>

                <!-- 9. preserve -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div>
                            <span class="tag-badge">Verb (regular)</span>
                            <div class="word-en">preserve (preserved)</div>
                        </div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('preserve'); playSound('click');" title="نطق الكلمة">🔊</button>
                    </div>
                    <div class="card-body">
                        <strong>المعنى:</strong> يَحْفَظ / يَصُون
                        <div class="simple-explain-box">
                            💡 <strong>التوضيح:</strong> يحمي الشيء ويحافظ عليه في حالته الجيدة دون تلف أو ضرر.
                        </div>
                    </div>
                </div>

                <!-- 10. pride -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div>
                            <span class="tag-badge">Noun</span>
                            <div class="word-en">pride</div>
                        </div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('pride'); playSound('click');" title="نطق الكلمة">🔊</button>
                    </div>
                    <div class="card-body">
                        <strong>المعنى:</strong> كِبْرِيَاء / فَخْر
                        <div class="simple-explain-box">
                            💡 <strong>التوضيح:</strong> شعور عميق بالرضا والاعتزاز بالنفس أو الوطن أو الإنجازات (take pride in).
                        </div>
                    </div>
                </div>

                <!-- 11. proud -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div>
                            <span class="tag-badge">Adjective</span>
                            <div class="word-en">proud</div>
                        </div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('proud'); playSound('click');" title="نطق الكلمة">🔊</button>
                    </div>
                    <div class="card-body">
                        <strong>المعنى:</strong> فَخُور
                        <div class="simple-explain-box">
                            💡 <strong>التوضيح:</strong> تشعر بالفخر تجاه إنجاز أو بلد (proud of / proud to call it our home).
                        </div>
                    </div>
                </div>

                <!-- 12. restore -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div>
                            <span class="tag-badge">Verb (regular)</span>
                            <div class="word-en">restore (restored)</div>
                        </div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('restore'); playSound('click');" title="نطق الكلمة">🔊</button>
                    </div>
                    <div class="card-body">
                        <strong>المعنى:</strong> يُرَمِّم / يُعِيد إلى حالته الأصلية
                        <div class="simple-explain-box">
                            💡 <strong>التوضيح:</strong> يصلح المباني أو الآثار القديمة لتعود كما كانت قديماً.
                        </div>
                    </div>
                </div>

                <!-- 13. trade -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div>
                            <span class="tag-badge">Noun</span>
                            <div class="word-en">trade</div>
                        </div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('trade'); playSound('click');" title="نطق الكلمة">🔊</button>
                    </div>
                    <div class="card-body">
                        <strong>المعنى:</strong> تِجَارَة / حِرْفَة
                        <div class="simple-explain-box">
                            💡 <strong>التوضيح:</strong> نشاط بيع وشراء السلع والبضائع والخدمات بين الأفراد أو الدول.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Part 2: Accumulative Vocabulary (46 items) -->
            <h3 class="section-subtitle" style="margin-top: 35px;">📚 المفردات اللغوية المساعدة والامتحانية (Accumulative Vocabulary) - 46 كلمة:</h3>
            <div class="grid-cards">
                <!-- 1. ancestor -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div><span class="tag-badge">Noun</span><div class="word-en">ancestor</div></div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('ancestor'); playSound('click');">🔊</button>
                    </div>
                    <div class="card-body"><strong>المعنى:</strong> جَدّ / سَلَف (الأسلاف من الماضي)</div>
                </div>

                <!-- 2. archaeologist -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div><span class="tag-badge">Noun</span><div class="word-en">archaeologist</div></div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('archaeologist'); playSound('click');">🔊</button>
                    </div>
                    <div class="card-body"><strong>المعنى:</strong> عَالِم آثَار (يدرس بقايا الحضارات القديمة)</div>
                </div>

                <!-- 3. attraction -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div><span class="tag-badge">Noun</span><div class="word-en">attraction</div></div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('attraction'); playSound('click');">🔊</button>
                    </div>
                    <div class="card-body"><strong>المعنى:</strong> مَعْلَم جَذْب / مَزَار سِيَاحِي</div>
                </div>

                <!-- 4. awareness -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div><span class="tag-badge">Noun</span><div class="word-en">awareness</div></div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('awareness'); playSound('click');">🔊</button>
                    </div>
                    <div class="card-body"><strong>المعنى:</strong> وَعْي / إِدْرَاك وفهم للأمور</div>
                </div>

                <!-- 5. beat -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div><span class="tag-badge">Verb</span><div class="word-en">beat - beat - beaten</div></div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('beat'); playSound('click');">🔊</button>
                    </div>
                    <div class="card-body"><strong>المعنى:</strong> يَنْبِض (للقلب) / يَهْزِم</div>
                </div>

                <!-- 6. bridge -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div><span class="tag-badge">Noun</span><div class="word-en">bridge</div></div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('bridge'); playSound('click');">🔊</button>
                    </div>
                    <div class="card-body"><strong>المعنى:</strong> جِسْر / كوبري / وَسِيلَة رَبْط وتواصل</div>
                </div>

                <!-- 7. capable -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div><span class="tag-badge">Adjective</span><div class="word-en">capable (of)</div></div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('capable'); playSound('click');">🔊</button>
                    </div>
                    <div class="card-body"><strong>المعنى:</strong> قَادِر على الإنجاز</div>
                </div>

                <!-- 8. carve -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div><span class="tag-badge">Verb</span><div class="word-en">carve (carved)</div></div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('carve'); playSound('click');">🔊</button>
                    </div>
                    <div class="card-body"><strong>المعنى:</strong> يَنْحَت على الحجر أو الخشب</div>
                </div>

                <!-- 9. challenge -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div><span class="tag-badge">Noun / Verb</span><div class="word-en">challenge</div></div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('challenge'); playSound('click');">🔊</button>
                    </div>
                    <div class="card-body"><strong>المعنى:</strong> تَحَدٍّ / يَتَحَدَّى</div>
                </div>

                <!-- 10. citizen -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div><span class="tag-badge">Noun</span><div class="word-en">citizen</div></div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('citizen'); playSound('click');">🔊</button>
                    </div>
                    <div class="card-body"><strong>المعنى:</strong> مُوَاطِن ينتمي للوطن وله حقوق وواجبات</div>
                </div>

                <!-- 11. contribute -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div><span class="tag-badge">Verb</span><div class="word-en">contribute (contributed)</div></div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('contribute'); playSound('click');">🔊</button>
                    </div>
                    <div class="card-body"><strong>المعنى:</strong> يُسَاهِم / يُشَارِك (contribute to)</div>
                </div>

                <!-- 12. core -->
                <div class="card" onclick="playSound('click')">
                    <div class="card-header">
                        <div><span class="tag-badge">Noun</span><div class="word-en">core</div></div>
                        <button class="audio-btn" onclick="event.stopPropagation(); speakText('core'); playSound('click');">🔊</button>
                    </div>
                    <div class="card-body"><strong>المعنى:</strong> جَوْهَر / لُبّ / أَسَاس الشيء</div>
                </div>

                <!-- 13. culture -->
                <div class="card" onclick="playSound('click')">
