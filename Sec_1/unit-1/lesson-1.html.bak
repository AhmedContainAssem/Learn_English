                { emoji: "📚", question: "21. According to the reading text, which famous place once gathered knowledge from all over the world?", options: [{ text: "The Library of Alexandria", isCorrect: true }, { text: "The Suez Canal", isCorrect: false }, { text: "The High Dam", isCorrect: false }, { text: "Karnak Airport", isCorrect: false }], correctMsg: "أحسنت! The Library of Alexandria = مكتبة الإسكندرية (+10)", wrongMsg: "مكتبة الإسكندرية هي التي جمعت المعرفة." },
                { emoji: "🏛️", question: "22. Which landmark was recently built to honor Egyptian history while shaping the future?", options: [{ text: "The Grand Egyptian Museum", isCorrect: true }, { text: "Eiffel Tower", isCorrect: false }, { text: "Big Ben", isCorrect: false }, { text: "Colosseum", isCorrect: false }], correctMsg: "ممتاز! The Grand Egyptian Museum = المتحف المصري الكبير (+10)", wrongMsg: "المتحف المصري الكبير هو The Grand Egyptian Museum." },
                { emoji: "🎙️", question: "23. In the interview, what historical site did Dr. Mona Hassan recently lead a team to restore?", options: [{ text: "Parts of the Philae Temple", isCorrect: true }, { text: "The Pyramids of Dahshur", isCorrect: false }, { text: "The Roman Amphitheatre", isCorrect: false }, { text: "The Citadel of Qaitbay", isCorrect: false }], correctMsg: "بطل! Philae Temple = معبد فيلة (+10)", wrongMsg: "معبد فيلة هو Philae Temple." },
                { emoji: "👥", question: "24. Dr. Mona emphasized that restoring ancient monuments is not just fixing stones, but:", options: [{ text: "reconnecting with our past and heritage", isCorrect: true }, { text: "making quick money from visitors", isCorrect: false }, { text: "painting the walls new colors", isCorrect: false }, { text: "closing the sites permanently", isCorrect: false }], correctMsg: "رائع! reconnecting with our past = إعادة التواصل والارتباط بماضينا (+10)", wrongMsg: "الهدف هو إعادة الاتصال مع ماضينا." },
                { emoji: "🛡️", question: "25. By inspiring our youth to value their heritage, we help them become the next generation of ________.", options: [{ text: "protectors", isCorrect: true }, { text: "passengers", isCorrect: false }, { text: "merchants", isCorrect: false }, { text: "strangers", isCorrect: false }], correctMsg: "ممتاز! protectors = حماة ومدافعين عن التراث (+10)", wrongMsg: "حماة التراث هم protectors." },

                // Curriculum Additions (Definitions, Synonyms, Antonyms, Collocations, Derivatives, Confusion Notes)
                { emoji: "🛣️", question: "26. A place where two or more roads meet, or an important meeting point for people and ideas, is a ________.", options: [{ text: "crossroads", isCorrect: true }, { text: "neighborhood", isCorrect: false }, { text: "monument", isCorrect: false }, { text: "merchant", isCorrect: false }], correctMsg: "أحسنت! تعريف ملتقى الطرق هو crossroads (+10)", wrongMsg: "crossroads هو ملتقى الطرق والأفكار." },
                { emoji: "🪪", question: "27. The qualities, beliefs, history, and culture that make a country different from others define its ________.", options: [{ text: "identity", isCorrect: true }, { text: "trade", isCorrect: false }, { text: "pride", isCorrect: false }, { text: "neighborhood", isCorrect: false }], correctMsg: "ممتاز! الهوية الوطنية هي identity (+10)", wrongMsg: "الهوية تعني identity." },
                { emoji: "✨", question: "28. What is the synonym of the adjective 'carved'?", options: [{ text: "engraved", isCorrect: true }, { text: "damaged", isCorrect: false }, { text: "ruined", isCorrect: false }, { text: "forgotten", isCorrect: false }], correctMsg: "بطل! مرادف carved هو engraved أو sculpted (+10)", wrongMsg: "مرادف منحوت (carved) هو engraved." },
                { emoji: "⚡", question: "29. What is the antonym (opposite) of the noun 'harmony'?", options: [{ text: "conflict", isCorrect: true }, { text: "agreement", isCorrect: false }, { text: "coordination", isCorrect: false }, { text: "peace", isCorrect: false }], correctMsg: "رائع! مضاد harmony (تناغم) هو conflict (نزاع وخلاف) (+10)", wrongMsg: "مضاد الانسجام هو conflict." },
                { emoji: "⚡", question: "30. What is the opposite of the noun 'determination'?", options: [{ text: "hesitation", isCorrect: true }, { text: "willpower", isCorrect: false }, { text: "courage", isCorrect: false }, { text: "strength", isCorrect: false }], correctMsg: "أحسنت! مضاد الإصرار والعزيمة هو التردد (hesitation) (+10)", wrongMsg: "مضاد determination هو hesitation أو indecision." },
                { emoji: "🔨", question: "31. The government launched a major project to ________ and renovate ancient temples.", options: [{ text: "restore", isCorrect: true }, { text: "destroy", isCorrect: false }, { text: "damage", isCorrect: false }, { text: "spoil", isCorrect: false }], correctMsg: "ممتاز! restore تعني يرمم ومرادفها renovate (+10)", wrongMsg: "يرمم هي restore." },
                { emoji: "🤝", question: "32. Our glorious ancestors worked hard to leave a valuable ________ for generations to come.", options: [{ text: "legacy", isCorrect: true }, { text: "damage", isCorrect: false }, { text: "shame", isCorrect: false }, { text: "ignorance", isCorrect: false }], correctMsg: "بطل! المتلازمة: leave a legacy = يترك إرثاً (+10)", wrongMsg: "leave a legacy تعني يترك إرثاً." },
                { emoji: "💓", question: "33. Egypt is a great land with a heart that has been ________ for thousands of years.", options: [{ text: "beating", isCorrect: true }, { text: "stopping", isCorrect: false }, { text: "falling", isCorrect: false }, { text: "carving", isCorrect: false }], correctMsg: "رائع! التعبير المنهجي: beat for thousands of years (+10)", wrongMsg: "beat for thousands of years ينبض منذ آلاف السنين." },
                { emoji: "🏆", question: "34. Every Egyptian has reason to ________ with pride when seeing the ancient pyramids.", options: [{ text: "stand", isCorrect: true }, { text: "sleep", isCorrect: false }, { text: "lack", isCorrect: false }, { text: "fall", isCorrect: false }], correctMsg: "أحسنت! stand with pride = يقف شامخاً وفخوراً (+10)", wrongMsg: "التعبير هو stand with pride." },
                { emoji: "✍️", question: "35. Ancient stories and religious texts were carefully carved ________ temple walls.", options: [{ text: "into", isCorrect: true }, { text: "off", isCorrect: false }, { text: "away", isCorrect: false }, { text: "against", isCorrect: false }], correctMsg: "ممتاز! حرف الجر المصاحب: carve into (+10)", wrongMsg: "carve into ينقش على." },
                { emoji: "🏛️", question: "36. We ________ our cultural heritage from past generations.", options: [{ text: "inherit", isCorrect: true }, { text: "inheritance", isCorrect: false }, { text: "inherited", isCorrect: false }, { text: "inheriting", isCorrect: false }], correctMsg: "بطل! الفعل بعد الفاعل we هو inherit (يرث) (+10)", wrongMsg: "الفعل هو inherit." },
                { emoji: "🎯", question: "37. She is fully ________ of leading the archaeological expedition.", options: [{ text: "capable", isCorrect: true }, { text: "able", isCorrect: false }, { text: "ability", isCorrect: false }, { text: "capable to", isCorrect: false }], correctMsg: "رائع! capable يأتي بعدها of + gerund، بينما able يأتي بعدها to + inf (+10)", wrongMsg: "نستخدم capable of + v-ing." },
                { emoji: "🤝", question: "38. After hours of calm discussion, the committee agreed ________ the new budget.", options: [{ text: "on", isCorrect: true }, { text: "to", isCorrect: false }, { text: "with", isCorrect: false }, { text: "in", isCorrect: false }], correctMsg: "أحسنت! agree on + noun تعني يتفق على موضوع (+10)", wrongMsg: "agree on the price / budget." },
                { emoji: "🏫", question: "39. I am very proud ________ represent my school in the national competition.", options: [{ text: "to", isCorrect: true }, { text: "of", isCorrect: false }, { text: "in", isCorrect: false }, { text: "for", isCorrect: false }], correctMsg: "ممتاز! be proud to + infinitive المصدر (+10)", wrongMsg: "proud to + inf." },
                { emoji: "⏰", question: "40. Please, ________ me to call Dr. Mona before she leaves the excavation site.", options: [{ text: "remind", isCorrect: true }, { text: "remember", isCorrect: false }, { text: "reminded", isCorrect: false }, { text: "remembering", isCorrect: false }], correctMsg: "بطل! remind someone to do something = يُذكّر شخصاً بعمل شيء (+10)", wrongMsg: "remind me تعني ذكّرني." }
            ]
        };

        // Sequential Dialogue Playback Engine
        let dialogueUtterance = null;
        let isDiagPlaying = false;
        let currentDiagIndex = 0;

        const dialogueTurns = [
            { id: 'diag-turn-0', text: "Welcome back to Our Story. Today, we are talking to Dr. Mona Hassan, an archaeologist who recently led a team to restore parts of the Philae Temple. Dr. Mona, thank you for joining us." },
            { id: 'diag-turn-1', text: "Thank you. It is a privilege to be here." },
            { id: 'diag-turn-2', text: "Your work on Philae is a powerful symbol. Can you tell us why preserving our heritage is so important?" },
            { id: 'diag-turn-3', text: "Of course. When we restore a historical site, we are not just fixing old stones. We are reconnecting with our past. Our ancestors left us a rich legacy, from the pyramids to the temples of Upper Egypt. This heritage is the core of our national identity. It reminds us of who we are, where we came from, and the greatness we are capable of. It is a source of immense pride for every Egyptian." },
            { id: 'diag-turn-4', text: "It sounds like more than a job, it is a mission. What do you think is the biggest challenge to preserving our heritage today?" },
            { id: 'diag-turn-5', text: "The challenges are many, from urban development to climate change. But perhaps the biggest is a lack of awareness among our youth. Many young people do not realize the value of these treasures. Our job is to inspire them, to make them see that a thousand-year-old temple is not just a tourist attraction, it is a living part of our story. We need to encourage them to visit these sites, to learn the stories, and to feel the connection." },
            { id: 'diag-turn-6', text: "That is a great point. You are inspiring them to become the next generation of protectors. Thank you, for your valuable work, Dr. Mona." }
        ];

        function toggleDialoguePlayAll() {
            if (isDiagPlaying) {
                stopDialoguePlayAll();
            } else {
                startDialoguePlayAll();
            }
        }

        function startDialoguePlayAll() {
            if (!('speechSynthesis' in window)) {
                alert('Audio speech is not supported in this browser.');
                return;
            }
            window.speechSynthesis.cancel();
            isDiagPlaying = true;
            currentDiagIndex = 0;
            const btn = document.getElementById('dialoguePlayAllBtn');
            if (btn) {
                btn.innerHTML = '⏸️ إيقاف القراءة المتتابعة (Stop)';
                btn.classList.add('playing');
            }
            playDiagStep(0);
        }

        function stopDialoguePlayAll() {
            isDiagPlaying = false;
            if (window.speechSynthesis) window.speechSynthesis.cancel();
            const btn = document.getElementById('dialoguePlayAllBtn');
            if (btn) {
                btn.innerHTML = '▶️ تشغيل المحادثة كاملة بالتتابع';
                btn.classList.remove('playing');
            }
            document.querySelectorAll('.dialogue-box').forEach(b => b.style.boxShadow = 'none');
        }

        function playDiagStep(idx) {
            if (!isDiagPlaying || idx >= dialogueTurns.length) {
                stopDialoguePlayAll();
                return;
            }
            currentDiagIndex = idx;
            document.querySelectorAll('.dialogue-box').forEach(b => b.style.boxShadow = 'none');
            const turn = dialogueTurns[idx];
            const box = document.getElementById(turn.id);
            if (box) {
                box.style.boxShadow = '0 0 15px rgba(0, 243, 255, 0.4)';
                box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            dialogueUtterance = new SpeechSynthesisUtterance(turn.text);
            dialogueUtterance.lang = 'en-US';
            dialogueUtterance.rate = 0.92;

            dialogueUtterance.onend = () => {
                if (!isDiagPlaying) return;
                setTimeout(() => {
                    playDiagStep(idx + 1);
                }, 700);
            };

            dialogueUtterance.onerror = () => {
                stopDialoguePlayAll();
            };

            window.speechSynthesis.speak(dialogueUtterance);
        }
    </script>

