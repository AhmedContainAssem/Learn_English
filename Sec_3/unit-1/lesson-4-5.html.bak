        <!-- ========================================== -->
        <!-- TAB 4: WRITING SKILLS: HOW TO WRITE A BLOG POST -->
        <!-- ========================================== -->
        <div id="writing-skills" class="tab-content" style="display: none;">
            
            <div class="section-title">✍️ دليل مهارة كتابة المنشور التدويني (How to Write a Blog Post - صفحات 65 : 68)</div>
            
            <!-- What is a blog post? -->
            <div class="card" style="border-right: 4px solid var(--accent-primary); margin-bottom: 25px; padding: 22px;">
                <h3 style="color: var(--accent-primary); margin-bottom: 12px; font-size: 1.3rem;">❓ ما هي المدونة؟ (What is a Blog Post?)</h3>
                <p style="font-size: 1.1rem; line-height: 1.8; color: #f8fafc;">
                    <strong>المدونة (A blog post):</strong> هي مقال أو قطعة كتابية تُنشر على مدونة إلكترونية (موقع أو مجلة على الإنترنت). وتتميز المقالات التدوينية بالمواصفات الأربع الأساسية التالية:
                </p>
                <div class="cards-grid grid-cards" style="margin-top: 14px;">
                    <div class="card" style="background: rgba(11, 15, 25, 0.7); border: 1px solid rgba(0, 243, 255, 0.3);">
                        <strong style="color: var(--accent-primary);">1. Informal or semi-formal:</strong><br>
                        أسلوب غير رسمي أو شبه رسمي، كالتحدث مع صديق لكنه أكثر تنظيماً.
                    </div>
                    <div class="card" style="background: rgba(11, 15, 25, 0.7); border: 1px solid rgba(0, 255, 157, 0.3);">
                        <strong style="color: var(--accent-green);">2. Engaging style:</strong><br>
                        أسلوب جذاب يهدف إلى لفت انتباه القارئ وشده للقراءة.
                    </div>
                    <div class="card" style="background: rgba(11, 15, 25, 0.7); border: 1px solid rgba(255, 183, 3, 0.3);">
                        <strong style="color: var(--accent-orange);">3. About a specific topic:</strong><br>
                        يركز على موضوع محدد يشارك فيه الكاتب معلومات أو آراء أو تجارب شخصية.
                    </div>
                    <div class="card" style="background: rgba(11, 15, 25, 0.7); border: 1px solid rgba(56, 189, 248, 0.3);">
                        <strong style="color: var(--accent-secondary);">4. Not too long:</strong><br>
                        غير طويلة ومقسمة لفقرات قصيرة لتكون سهلة القراءة السريعة على الإنترنت.
                    </div>
                </div>
            </div>

            <!-- Steps to write a blog post -->
            <div class="section-title">🧱 أجزاء ومنظومة هيكل المدونة الناجحة (The 4 Parts of a Good Blog Post)</div>
            <div class="cards-grid grid-cards" style="margin-bottom: 30px;">
                
                <div class="card" style="border-top: 3px solid var(--accent-primary);">
                    <div class="card-header">
                        <span class="tag-badge">الجزء 1</span>
                        <div class="word-en" style="color: var(--accent-primary);">1. Catchy Title (Headline)</div>
                    </div>
                    <div class="card-body">
                        <strong>الغرض (Purpose):</strong> جعل الناس يرغبون في النقر على الرابط وقراءة المقال فوراً (To make people want to click and read!).
                        <div class="simple-explain-box" style="margin-top: 8px;">
                            💡 <strong>أمثلة من كتاب الوزارة:</strong>
                            <div dir="ltr" style="direction: ltr; text-align: left; margin-top: 6px; line-height: 1.7; color: var(--accent-secondary);">
                                • <em>5 Amazing Places to Visit in Summer</em><br>
                                • <em>My First Time Trying Sushi (and Why I Loved It!)</em><br>
                                • <em>Is Learning English Hard? My Opinion.</em>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card" style="border-top: 3px solid var(--accent-green);">
                    <div class="card-header">
                        <span class="tag-badge">الجزء 2</span>
                        <div class="word-en" style="color: var(--accent-green);">2. Introduction (The Hook)</div>
                    </div>
                    <div class="card-body">
                        <strong>الغرض (Purpose):</strong> تقديم الموضوع وخطف اهتمام القارئ وجذبه بالـ (Hook) كسؤال مثير أو اقتباس أو حقيقة مشوقة.
                        <div class="simple-explain-box" style="margin-top: 8px;">
                            💡 <strong>مثال المقدمة:</strong>
                            <div dir="ltr" style="direction: ltr; text-align: left; margin-top: 6px; line-height: 1.7; color: var(--accent-green);">
                                <em>“Have you ever dreamed of traveling the world? For me, visiting new countries has always been a passion. Today, I want to share my recent trip to Japan...”</em>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card" style="border-top: 3px solid var(--accent-orange);">
                    <div class="card-header">
                        <span class="tag-badge">الجزء 3</span>
                        <div class="word-en" style="color: var(--accent-orange);">3. Main Body (With Subheadings)</div>
                    </div>
                    <div class="card-body">
                        <strong>الغرض (Purpose):</strong> تطوير الأفكار وتقديم التفاصيل وشرح النقاط مع استخدام عناوين فرعية (Subheadings) لتقسيم الموضوع.
                        <div class="simple-explain-box" style="margin-top: 8px;">
                            💡 <strong>أمثلة الفقرات:</strong>
                            <div dir="ltr" style="direction: ltr; text-align: left; margin-top: 6px; line-height: 1.7; color: var(--accent-orange);">
                                • <em>Paragraph 1 (Food): One of the best parts was food (sushi, ramen)...</em><br>
                                • <em>Paragraph 2 (Culture): Fascinated by traditional culture and tea ceremony...</em>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card" style="border-top: 3px solid var(--accent-secondary);">
                    <div class="card-header">
                        <span class="tag-badge">الجزء 4</span>
                        <div class="word-en" style="color: var(--accent-secondary);">4. Conclusion (With CTA)</div>
                    </div>
                    <div class="card-body">
                        <strong>الغرض (Purpose):</strong> تلخيص الأفكار الرئيسية، وإعطاء فكرة ختامية، وختم المقال بدعوة لاتخاذ إجراء (Call to Action - CTA) كدعوة القراء للتعليق.
                        <div class="simple-explain-box" style="margin-top: 8px;">
                            💡 <strong>مثال الخاتمة:</strong>
                            <div dir="ltr" style="direction: ltr; text-align: left; margin-top: 6px; line-height: 1.7; color: var(--accent-secondary);">
                                <em>“Overall, my trip to Japan was an unforgettable experience... Have you ever been to Japan? What was your favorite part? Let me know in the comments!”</em>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Language & Style Tips + Terminology Table -->
            <div class="section-title">💡 إرشادات اللغة والأسلوب والمصطلحات التدوينية (Terminology Glossary - ص 66)</div>
            <div class="card" style="padding: 20px; margin-bottom: 30px;">
                <h4 style="color: var(--accent-primary); margin-bottom: 12px;">🌟 إرشادات اللغة والأسلوب (Tips on Language &amp; Style):</h4>
                <ul style="line-height: 2; color: #f8fafc; padding-right: 20px; list-style-type: square;">
                    <li><strong>1. استخدم لغة بسيطة وواضحة (Use simple, clear language).</strong></li>
                    <li><strong>2. اجعل الفقرات قصيرة (Keep paragraphs short - 2 to 5 sentences).</strong></li>
                    <li><strong>3. اكتب بنبرة ودية وشخصية (Write in a friendly, personal tone).</strong></li>
                    <li><strong>4. استخدم ضمير المتكلم (Use first person: "I", "we")</strong> إذا كان المنشور يحكي تجربة شخصية أو سردية.</li>
                    <li><strong>5. أضف لغة تعبيرية وعواطف ومصطلحات اصطلاحية (Add expressive language, idioms or emotions)</strong> عند الاقتضاء.</li>
                </ul>

                <h4 style="color: var(--accent-green); margin-top: 24px; margin-bottom: 14px;">📖 جدول مصطلحات التدوين المعتمدة (Blog Post Terminology):</h4>
                <div class="cards-grid grid-cards">
                    <div class="card" style="background: rgba(11, 15, 25, 0.6);"><strong style="color: var(--accent-primary);">Audience (الجمهور):</strong> The readers the post is intended for (e.g. teenagers, students, general public).</div>
                    <div class="card" style="background: rgba(11, 15, 25, 0.6);"><strong style="color: var(--accent-primary);">Blog (المدونة):</strong> A regularly updated website or journal that contains individual entries called blog posts.</div>
                    <div class="card" style="background: rgba(11, 15, 25, 0.6);"><strong style="color: var(--accent-primary);">Blog Post (منشور المدونة):</strong> A single article or entry published on a blog.</div>
                    <div class="card" style="background: rgba(11, 15, 25, 0.6);"><strong style="color: var(--accent-orange);">Call to Action (CTA):</strong> A sentence encouraging the reader to take an action (e.g., comment, share, subscribe).</div>
                    <div class="card" style="background: rgba(11, 15, 25, 0.6);"><strong style="color: var(--accent-green);">Catchy Title:</strong> A headline designed to attract clicks and grab the reader's attention.</div>
                    <div class="card" style="background: rgba(11, 15, 25, 0.6);"><strong style="color: var(--accent-green);">Hook (الخاطف):</strong> An engaging opening that grabs the reader's attention (a question, quote, fact, or anecdote).</div>
                    <div class="card" style="background: rgba(11, 15, 25, 0.6);"><strong style="color: var(--accent-secondary);">Subheading (عنوان فرعي):</strong> A smaller heading used to divide sections of a blog post for easier reading.</div>
                    <div class="card" style="background: rgba(11, 15, 25, 0.6);"><strong style="color: var(--accent-secondary);">Tone (نبرة الكاتب):</strong> The style or attitude of the writer, such as formal, informal, humorous, or serious.</div>
                    <div class="card" style="background: rgba(11, 15, 25, 0.6);"><strong style="color: var(--accent-primary);">Topic (الموضوع):</strong> The subject or theme of the blog post.</div>
                    <div class="card" style="background: rgba(11, 15, 25, 0.6);"><strong style="color: var(--accent-orange);">Transition Words:</strong> Words like first, next, however, finally that help connect ideas smoothly.</div>
                </div>
            </div>

            <!-- Subjective Model Exercises on Aswan in Winter -->
            <div class="section-title">📝 النماذج المقالية التدريبية (Model Exercises: 5 Reasons to Visit Aswan in Winter - ص 67)</div>
            <div class="cards-grid grid-cards" style="margin-bottom: 30px;">
                <div class="card">
                    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span class="tag-badge">Model 1: Introduction</span>
                            <div class="word-en" style="color: var(--accent-primary);">المقدمة النموذجية (Intro)</div>
                        </div>
                        <button type="button" class="audio-btn" onclick="speakText('Have you ever dreamed of escaping the cold while still enjoying the magic of winter? Aswan, one of Egypts most charming cities, offers the perfect warm-weather getaway during the cooler months.'); playSound('click');" title="استمع للمقدمة">🔊</button>
                    </div>
                    <div class="card-body">
                        <div class="practical-example-box" dir="ltr" style="direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 0.96rem; line-height: 1.85; padding: 16px; border-radius: 12px; background: rgba(8, 14, 26, 0.85); border: 1px solid rgba(0, 243, 255, 0.25);">
                            “Have you ever dreamed of escaping the cold while still enjoying the magic of winter? Aswan, one of Egypt’s most charming cities, offers the perfect warm-weather getaway during the cooler months. With its golden sunshine, peaceful Nile views, and rich cultural heritage, Aswan becomes a magical destination between November and February. Whether you’re a history lover, an adventure seeker, or simply someone looking to relax, Aswan in winter has something just for you. In this post, I’ll share five great reasons why this southern gem should be at the top of your winter travel list.”
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span class="tag-badge">Model 2: Body Paragraph</span>
                            <div class="word-en" style="color: var(--accent-green);">فقرة الموضوع النموذجية (Body)</div>
                        </div>
                        <button type="button" class="audio-btn" onclick="speakText('Unlike other tourist hotspots, Aswan stays calm and uncrowded during winter. This means you can explore temples like Philae or stroll along the Nile without being rushed.'); playSound('click');" title="استمع لفقرة الموضوع">🔊</button>
                    </div>
                    <div class="card-body">
                        <div class="practical-example-box" dir="ltr" style="direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 0.96rem; line-height: 1.85; padding: 16px; border-radius: 12px; background: rgba(8, 14, 26, 0.85); border: 1px solid rgba(0, 255, 157, 0.25);">
                            “Unlike other tourist hotspots, Aswan stays calm and uncrowded during winter. This means you can explore temples like Philae or stroll along the Nile without being rushed or surrounded by large groups. The peaceful atmosphere allows you to truly connect with the history and beauty around you. Local markets are less busy, so you can chat with friendly vendors and take your time picking souvenirs. Even the felucca rides feel more personal and relaxed. It’s the perfect setting for travelers who enjoy slow, meaningful experiences.”
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span class="tag-badge">Model 3: Conclusion</span>
                            <div class="word-en" style="color: var(--accent-orange);">الخاتمة النموذجية (Conclusion)</div>
                        </div>
                        <button type="button" class="audio-btn" onclick="speakText('To conclude, Aswan in winter offers more than just sunshine, it gives you peace, culture, and unforgettable memories. From its mild weather to peaceful sights, it is the perfect winter escape.'); playSound('click');" title="استمع للخاتمة">🔊</button>
                    </div>
                    <div class="card-body">
                        <div class="practical-example-box" dir="ltr" style="direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 0.96rem; line-height: 1.85; padding: 16px; border-radius: 12px; background: rgba(8, 14, 26, 0.85); border: 1px solid rgba(255, 183, 3, 0.25);">
                            “To conclude, Aswan in winter offers more than just sunshine—it gives you peace, culture, and unforgettable memories. From its mild weather to peaceful sights, it’s the perfect winter escape. You can enjoy local life, explore history, and relax by the Nile. Whether you’re an adventurer, a culture lover, or just someone who needs a break. To sum up, Aswan welcomes you warmly. So, why wait? Pack your bags and discover the magic of Aswan this winter!”
                        </div>
                    </div>
                </div>
            </div>

            <!-- 15 Exam Points for Multiple Choice Questions -->
            <div class="section-title">🎯 نقاط مهارة الكتابة لأسئلة الاختيار من متعدد في الامتحان (Writing in Points - ص 68)</div>
            <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 30px;">
                <div class="card" dir="ltr" style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 18px; margin: 0; direction: ltr; text-align: left; unicode-bidi: isolate; background: rgba(13, 21, 39, 0.85); border: 1px solid rgba(0, 243, 255, 0.2);">
                    <span style="background: rgba(0, 243, 255, 0.15); color: var(--accent-primary); border: 1px solid var(--accent-primary); font-weight: 800; font-size: 0.95rem; min-width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">1</span>
                    <div style="flex: 1; direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 1.02rem; line-height: 1.7; color: #f8fafc;">
                        A <strong style="color: var(--accent-primary);">blog post</strong> is an article or a piece of writing published on a <strong style="color: var(--accent-primary);">blog</strong>.
                    </div>
                    <button type="button" class="audio-btn" onclick="speakText('A blog post is an article or a piece of writing published on a blog.'); playSound('click');" title="Listen" style="margin-top: 2px;">🔊</button>
                </div>
                <div class="card" dir="ltr" style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 18px; margin: 0; direction: ltr; text-align: left; unicode-bidi: isolate; background: rgba(13, 21, 39, 0.85); border: 1px solid rgba(0, 243, 255, 0.2);">
                    <span style="background: rgba(0, 243, 255, 0.15); color: var(--accent-primary); border: 1px solid var(--accent-primary); font-weight: 800; font-size: 0.95rem; min-width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">2</span>
                    <div style="flex: 1; direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 1.02rem; line-height: 1.7; color: #f8fafc;">
                        Blog posts are usually written in an <strong style="color: var(--accent-secondary);">informal</strong> or <strong style="color: var(--accent-secondary);">semi-formal style</strong>.
                    </div>
                    <button type="button" class="audio-btn" onclick="speakText('Blog posts are usually written in an informal or semi-formal style.'); playSound('click');" title="Listen" style="margin-top: 2px;">🔊</button>
                </div>
                <div class="card" dir="ltr" style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 18px; margin: 0; direction: ltr; text-align: left; unicode-bidi: isolate; background: rgba(13, 21, 39, 0.85); border: 1px solid rgba(0, 243, 255, 0.2);">
                    <span style="background: rgba(0, 243, 255, 0.15); color: var(--accent-primary); border: 1px solid var(--accent-primary); font-weight: 800; font-size: 0.95rem; min-width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">3</span>
                    <div style="flex: 1; direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 1.02rem; line-height: 1.7; color: #f8fafc;">
                        The writer of a blog post uses an <strong style="color: var(--accent-green);">engaging style</strong> to catch the reader’s attention.
                    </div>
                    <button type="button" class="audio-btn" onclick="speakText('The writer of a blog post uses an engaging style to catch the readers attention.'); playSound('click');" title="Listen" style="margin-top: 2px;">🔊</button>
                </div>
                <div class="card" dir="ltr" style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 18px; margin: 0; direction: ltr; text-align: left; unicode-bidi: isolate; background: rgba(13, 21, 39, 0.85); border: 1px solid rgba(0, 243, 255, 0.2);">
                    <span style="background: rgba(0, 243, 255, 0.15); color: var(--accent-primary); border: 1px solid var(--accent-primary); font-weight: 800; font-size: 0.95rem; min-width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">4</span>
                    <div style="flex: 1; direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 1.02rem; line-height: 1.7; color: #f8fafc;">
                        A blog post usually focuses on a <strong style="color: var(--accent-orange);">specific topic</strong>.
                    </div>
                    <button type="button" class="audio-btn" onclick="speakText('A blog post usually focuses on a specific topic.'); playSound('click');" title="Listen" style="margin-top: 2px;">🔊</button>
                </div>
                <div class="card" dir="ltr" style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 18px; margin: 0; direction: ltr; text-align: left; unicode-bidi: isolate; background: rgba(13, 21, 39, 0.85); border: 1px solid rgba(0, 243, 255, 0.2);">
                    <span style="background: rgba(0, 243, 255, 0.15); color: var(--accent-primary); border: 1px solid var(--accent-primary); font-weight: 800; font-size: 0.95rem; min-width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">5</span>
                    <div style="flex: 1; direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 1.02rem; line-height: 1.7; color: #f8fafc;">
                        A blog post may include <strong style="color: var(--accent-primary);">information</strong>, <strong style="color: var(--accent-primary);">opinions</strong> or <strong style="color: var(--accent-primary);">personal experiences</strong>.
                    </div>
                    <button type="button" class="audio-btn" onclick="speakText('A blog post may include information, opinions or personal experiences.'); playSound('click');" title="Listen" style="margin-top: 2px;">🔊</button>
                </div>
                <div class="card" dir="ltr" style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 18px; margin: 0; direction: ltr; text-align: left; unicode-bidi: isolate; background: rgba(13, 21, 39, 0.85); border: 1px solid rgba(0, 243, 255, 0.2);">
                    <span style="background: rgba(0, 243, 255, 0.15); color: var(--accent-primary); border: 1px solid var(--accent-primary); font-weight: 800; font-size: 0.95rem; min-width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">6</span>
                    <div style="flex: 1; direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 1.02rem; line-height: 1.7; color: #f8fafc;">
                        A blog post should not be <strong style="color: var(--accent-red);">too long</strong>, so it is easy to read online.
                    </div>
                    <button type="button" class="audio-btn" onclick="speakText('A blog post should not be too long, so it is easy to read online.'); playSound('click');" title="Listen" style="margin-top: 2px;">🔊</button>
                </div>
                <div class="card" dir="ltr" style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 18px; margin: 0; direction: ltr; text-align: left; unicode-bidi: isolate; background: rgba(13, 21, 39, 0.85); border: 1px solid rgba(0, 243, 255, 0.2);">
                    <span style="background: rgba(0, 243, 255, 0.15); color: var(--accent-primary); border: 1px solid var(--accent-primary); font-weight: 800; font-size: 0.95rem; min-width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">7</span>
                    <div style="flex: 1; direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 1.02rem; line-height: 1.7; color: #f8fafc;">
                        The structure of a good blog post consists of four parts: a <strong style="color: var(--accent-primary);">catchy title</strong>, an <strong style="color: var(--accent-green);">introduction</strong>, a <strong style="color: var(--accent-orange);">main body</strong> and a <strong style="color: var(--accent-secondary);">conclusion</strong>.
                    </div>
                    <button type="button" class="audio-btn" onclick="speakText('The structure of a good blog post consists of four parts: a catchy title, an introduction, a main body and a conclusion.'); playSound('click');" title="Listen" style="margin-top: 2px;">🔊</button>
                </div>
                <div class="card" dir="ltr" style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 18px; margin: 0; direction: ltr; text-align: left; unicode-bidi: isolate; background: rgba(13, 21, 39, 0.85); border: 1px solid rgba(0, 243, 255, 0.2);">
                    <span style="background: rgba(0, 243, 255, 0.15); color: var(--accent-primary); border: 1px solid var(--accent-primary); font-weight: 800; font-size: 0.95rem; min-width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">8</span>
                    <div style="flex: 1; direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 1.02rem; line-height: 1.7; color: #f8fafc;">
                        The title should be <strong style="color: var(--accent-primary);">catchy and clear</strong> and should summarize the content of the post.
                    </div>
                    <button type="button" class="audio-btn" onclick="speakText('The title should be catchy and clear and should summarize the content of the post.'); playSound('click');" title="Listen" style="margin-top: 2px;">🔊</button>
                </div>
                <div class="card" dir="ltr" style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 18px; margin: 0; direction: ltr; text-align: left; unicode-bidi: isolate; background: rgba(13, 21, 39, 0.85); border: 1px solid rgba(0, 243, 255, 0.2);">
                    <span style="background: rgba(0, 243, 255, 0.15); color: var(--accent-primary); border: 1px solid var(--accent-primary); font-weight: 800; font-size: 0.95rem; min-width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">9</span>
                    <div style="flex: 1; direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 1.02rem; line-height: 1.7; color: #f8fafc;">
                        In the introduction, we present the topic and start with a <strong style="color: var(--accent-green);">hook</strong>.
                    </div>
                    <button type="button" class="audio-btn" onclick="speakText('In the introduction, we present the topic and start with a hook.'); playSound('click');" title="Listen" style="margin-top: 2px;">🔊</button>
                </div>
                <div class="card" dir="ltr" style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 18px; margin: 0; direction: ltr; text-align: left; unicode-bidi: isolate; background: rgba(13, 21, 39, 0.85); border: 1px solid rgba(0, 243, 255, 0.2);">
                    <span style="background: rgba(0, 243, 255, 0.15); color: var(--accent-primary); border: 1px solid var(--accent-primary); font-weight: 800; font-size: 0.95rem; min-width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">10</span>
                    <div style="flex: 1; direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 1.02rem; line-height: 1.7; color: #f8fafc;">
                        A hook is <strong style="color: var(--accent-green);">an engaging opening</strong> such as a question, a quote, a fact or an anecdote.
                    </div>
                    <button type="button" class="audio-btn" onclick="speakText('A hook is an engaging opening such as a question, a quote, a fact or an anecdote.'); playSound('click');" title="Listen" style="margin-top: 2px;">🔊</button>
                </div>
                <div class="card" dir="ltr" style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 18px; margin: 0; direction: ltr; text-align: left; unicode-bidi: isolate; background: rgba(13, 21, 39, 0.85); border: 1px solid rgba(0, 243, 255, 0.2);">
                    <span style="background: rgba(0, 243, 255, 0.15); color: var(--accent-primary); border: 1px solid var(--accent-primary); font-weight: 800; font-size: 0.95rem; min-width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">11</span>
                    <div style="flex: 1; direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 1.02rem; line-height: 1.7; color: #f8fafc;">
                        In the main body, we <strong style="color: var(--accent-orange);">develop our ideas</strong>, <strong style="color: var(--accent-orange);">provide details</strong> and <strong style="color: var(--accent-orange);">explain our points</strong>.
                    </div>
                    <button type="button" class="audio-btn" onclick="speakText('In the main body, we develop our ideas, provide details and explain our points.'); playSound('click');" title="Listen" style="margin-top: 2px;">🔊</button>
                </div>
                <div class="card" dir="ltr" style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 18px; margin: 0; direction: ltr; text-align: left; unicode-bidi: isolate; background: rgba(13, 21, 39, 0.85); border: 1px solid rgba(0, 243, 255, 0.2);">
                    <span style="background: rgba(0, 243, 255, 0.15); color: var(--accent-primary); border: 1px solid var(--accent-primary); font-weight: 800; font-size: 0.95rem; min-width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">12</span>
                    <div style="flex: 1; direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 1.02rem; line-height: 1.7; color: #f8fafc;">
                        We can use <strong style="color: var(--accent-secondary);">subheadings</strong> to divide the blog post into sections and make it easier to read.
                    </div>
                    <button type="button" class="audio-btn" onclick="speakText('We can use subheadings to divide the blog post into sections and make it easier to read.'); playSound('click');" title="Listen" style="margin-top: 2px;">🔊</button>
                </div>
                <div class="card" dir="ltr" style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 18px; margin: 0; direction: ltr; text-align: left; unicode-bidi: isolate; background: rgba(13, 21, 39, 0.85); border: 1px solid rgba(0, 243, 255, 0.2);">
                    <span style="background: rgba(0, 243, 255, 0.15); color: var(--accent-primary); border: 1px solid var(--accent-primary); font-weight: 800; font-size: 0.95rem; min-width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">13</span>
                    <div style="flex: 1; direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 1.02rem; line-height: 1.7; color: #f8fafc;">
                        We should use <strong style="color: var(--accent-primary);">simple, clear language</strong>, short paragraphs and a friendly, personal tone.
                    </div>
                    <button type="button" class="audio-btn" onclick="speakText('We should use simple, clear language, short paragraphs and a friendly, personal tone.'); playSound('click');" title="Listen" style="margin-top: 2px;">🔊</button>
                </div>
                <div class="card" dir="ltr" style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 18px; margin: 0; direction: ltr; text-align: left; unicode-bidi: isolate; background: rgba(13, 21, 39, 0.85); border: 1px solid rgba(0, 243, 255, 0.2);">
                    <span style="background: rgba(0, 243, 255, 0.15); color: var(--accent-primary); border: 1px solid var(--accent-primary); font-weight: 800; font-size: 0.95rem; min-width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">14</span>
                    <div style="flex: 1; direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 1.02rem; line-height: 1.7; color: #f8fafc;">
                        In a personal or narrative blog post, we usually use <strong style="color: var(--accent-green);">the first person</strong>, such as “I” and “we”.
                    </div>
                    <button type="button" class="audio-btn" onclick="speakText('In a personal or narrative blog post, we usually use the first person, such as I and we.'); playSound('click');" title="Listen" style="margin-top: 2px;">🔊</button>
                </div>
                <div class="card" dir="ltr" style="display: flex; align-items: flex-start; gap: 14px; padding: 14px 18px; margin: 0; direction: ltr; text-align: left; unicode-bidi: isolate; background: rgba(13, 21, 39, 0.85); border: 1px solid rgba(0, 243, 255, 0.2);">
                    <span style="background: rgba(0, 243, 255, 0.15); color: var(--accent-primary); border: 1px solid var(--accent-primary); font-weight: 800; font-size: 0.95rem; min-width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">15</span>
                    <div style="flex: 1; direction: ltr; text-align: left; unicode-bidi: isolate; font-size: 1.02rem; line-height: 1.7; color: #f8fafc;">
                        In the conclusion, we <strong style="color: var(--accent-secondary);">summarize the main points</strong>, give a final thought and may end with a <strong style="color: var(--accent-orange);">call to action (CTA)</strong>. We also use transition words such as first, next, however and finally to connect ideas smoothly.
                    </div>
                    <button type="button" class="audio-btn" onclick="speakText('In the conclusion, we summarize the main points, give a final thought and may end with a call to action.'); playSound('click');" title="Listen" style="margin-top: 2px;">🔊</button>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 5: INTERACTIVE STORYBOOK -->
        <!-- ========================================== -->
        <div id="storybook" class="tab-content" style="display: none;">
            <div class="section-title">📚 القراءة التفاعلية المصورة (Interactive Storybook - 7 مشاهد كاملة)</div>
            <div class="lesson-desc-display" style="text-align: right; margin-bottom: 20px;">
                💡 <strong>Beyond the White Coat &amp; My Blog Post:</strong> استمتع بقراءة نصوص كتاب الطالب المعتمدة (الدرس 4 و 5) عبر محرك الكتاب التفاعلي ثلاثي الأبعاد مع اللوحات التوضيحية البصرية الدقيقة، القارئ الصوتي التلقائي (Auto Storyteller)، الترجمة المعتمدة، وشارات المفردات اللغوية.
            </div>

            <!-- Reading Decks Switcher Pills -->
            <div style="display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap;">
                <button type="button" id="storyTabBtn-0" class="badge badge-active story-select-btn" onclick="selectStoryDeck(0)" style="cursor: pointer; padding: 8px 16px; font-size: 0.95rem;">
                    📖 النص الأول: ما وراء المعطف الأبيض (Beyond the White Coat - 4 مشاهد)
                </button>
                <button type="button" id="storyTabBtn-1" class="badge story-select-btn" onclick="selectStoryDeck(1)" style="cursor: pointer; padding: 8px 16px; font-size: 0.95rem;">
                    📝 النص الثاني: مدونتي وتجربة نزلة البرد (My Unwelcome Visitor - 3 مشاهد)
                </button>
            </div>

            <!-- Interactive 3D Book Container from Teacher Studio Engine -->
            <div class="storybook-wrapper">
                <div class="storybook-book">
                    <!-- Center Book Spine -->
                    <div class="book-spine-divider"></div>

                    <!-- Right Page: Scene Artwork -->
                    <div class="story-page-artwork">
                        <div class="artwork-page-inner">
                            <div class="page-badge-artwork">
                                <span id="storyPageBadge">🖼️ Scene 1 of 4</span>
                            </div>
                            <div class="artwork-container">
                                <img id="storyArtworkImg" src="./sec 3 storybook photos/sec3_u1_l45_scene1_ambulance_storm.webp" alt="Scene Artwork" referrerpolicy="no-referrer">
                            </div>
                            <div class="artwork-caption" id="storyCaption">
                                Paramedics rushing car crash victim into hospital during heavy rainstorm
                            </div>
                        </div>
                        <div class="story-page-meta">
                            <span id="storyDeckMeta">📖 Beyond the White Coat (SB p. 20)</span>
                            <span id="storyPageCounter">Page 1 / 4</span>
                        </div>
                    </div>

                    <!-- Left Page: Story Reading Passage -->
                    <div class="story-page-content">
                        <div>
                            <div class="story-header">
                                <h3 class="story-page-title" id="storyTitle">Scene 1: Paramedics Rush In &amp; Stormy Arrival</h3>
                                <button type="button" class="audio-btn" onclick="speakCurrentStoryPage(this)" title="استمع للنطق">🔊</button>
                            </div>
                            <div class="story-paragraph" id="storyText">
                                Last night, paramedics rushed in with a man injured in a car crash. He had broken his leg before arrival, and his face was covered in blood. Nurses quickly took him for X-rays while Dr. Maha prepared to stitch a deep cut on his forehead. “Teamwork saved him,” said the emergency room “ER” director proudly. Outside, it was raining cats and dogs as Dr. Basem ran into the hospital, soaked to the skin.
                            </div>
                        </div>
                        <div>
                            <div class="story-translation-box" id="storyTranslation">
                                <span class="translation-tag">💡 الترجمة المعتمدة:</span>
                                في الليلة الماضية، هرع المسعفون برجل أصيب في حادث سيارة. كان قد كُسرت ساقه قبل وصوله، وكان وجهه مغطى بالدماء. سارعت الممرضات بنقله لإجراء أشعة سينية بينما استعدت الدكتورة مها لخياطة جرح عميق في جبهته. قال مدير غرفة الطوارئ بفخر: "لقد أنقذه العمل الجماعي". وفي الخارج، كانت السماء تمطر بغزارة شديدة عندما ركض الدكتور باسم إلى داخل المستشفى مبتلاً تماماً من رأسه لقدمه.
                            </div>
                            <div class="story-vocab-chips" id="storyVocab">
                                <span class="vocab-chip">paramedics rushed in (هرع المسعفون)</span>
                                <span class="vocab-chip">car crash (حادث سيارة)</span>
                                <span class="vocab-chip">stitch (يخيط الجرح)</span>
                                <span class="vocab-chip">forehead (جبهة / جبين)</span>
                                <span class="vocab-chip">raining cats and dogs (تمطر بغزارة)</span>
                                <span class="vocab-chip">soaked to the skin (مبتل تماماً)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Story Controls Bar -->
                <div class="story-controls-bar">
                    <button type="button" id="storyPrevBtn" onclick="changeStoryPage(-1)" class="action-btn secondary" disabled>
                        ⬅️ المشهد السابق
                    </button>
                    <button type="button" id="storytellerBtn" onclick="toggleStoryteller()" class="storyteller-btn">
                        ▶️ القارئ التلقائي (Auto Storyteller)
                    </button>
                    <div class="story-page-progress">
                        <span id="storyPageProgressText">Scene 1 of 4</span>
                        <div class="progress-dots" id="storyProgressDots">
                            <span class="dot active"></span>
                            <span class="dot"></span>
                            <span class="dot"></span>
                            <span class="dot"></span>
                        </div>
                    </div>
                    <button type="button" id="storyNextBtn" onclick="changeStoryPage(1)" class="action-btn secondary">
                        المشهد التالي ➔
                    </button>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 6: INTERACTIVE QUIZ -->
        <!-- ========================================== -->
        <div id="quiz" class="tab-content" style="display: none;">
            <div class="section-title">🎯 اختبار الدرس الشامل (Mastery Practice Quiz - Lessons 4 &amp; 5)</div>
            <p class="section-hint">اختر الإجابة الصحيحة. يمنحك كل سؤال صحيح 10 نقاط فورية مع المؤثرات الصوتية والتعليل التعليمي النموذجي 🌟</p>

            <div class="quiz-container-card">
                <div id="quiz-header" class="quiz-header-bar">
                    <div class="score-badge">
                        <span>النتيجة: </span>
                        <span id="score-display" class="score-value">0</span>
                    </div>
                    <div class="progress-badge">
                        <span>السؤال: </span>
                        <span id="current-question-num">1</span> / <span id="total-questions-num">35</span>
                    </div>
                </div>

                <div id="question-box" class="quiz-question-box">
                    <!-- Injected dynamically by Quiz Engine -->
                </div>

                <div id="options-box" class="quiz-options-grid">
                    <!-- Options injected dynamically -->
                </div>

                <div id="feedback-box" class="quiz-feedback-box hidden">
                    <!-- Feedback injected dynamically -->
                </div>

                <div class="quiz-actions-bar">
                    <button id="next-btn" class="action-btn next-btn hidden" onclick="nextQuestion()">السؤال التالي ➔</button>
                    <button id="retry-btn" class="action-btn secondary hidden" onclick="restartQuiz()">🔄 إعادة المحاولة</button>
                </div>
            </div>
        </div>

        <!-- Navigation Controls Footer -->
        <div class="nav-controls" style="margin-top: 35px; text-align: center;">
            <a href="./index.html" class="back-btn" data-sound-click="click">⬅️ العودة لفهرس الوحدة الأولى (Inside the World of Care)</a>
        </div>
    </div>

    <!-- Data Bridge & Engine Integration Scripts -->
    <script>
        // ==========================================
        // 1. Reading Decks for StoryEngine
        // ==========================================
        window.readingDecks = [
            // Deck 1: Beyond the White Coat (SB p. 20)
            {
                id: "beyond_the_white_coat",
                title: "📖 النص الأول: ما وراء المعطف الأبيض (Beyond the White Coat - SB p. 20)",
                pages: [
                    {
                        title: "Scene 1: Paramedics Rush In & Stormy Arrival",
                        imageUrl: "./sec 3 storybook photos/sec3_u1_l45_scene1_ambulance_storm.webp",
                        caption: "Paramedics rushing car crash victim into hospital during heavy rainstorm",
                        textEn: "Last night, paramedics rushed in with a man injured in a car crash. He had broken his leg before arrival, and his face was covered in blood. Nurses quickly took him for X-rays while Dr. Maha prepared to stitch a deep cut on his forehead. “Teamwork saved him,” said the emergency room “ER” director proudly. Outside, it was raining cats and dogs as Dr. Basem ran into the hospital, soaked to the skin.",
                        textAr: "في الليلة الماضية، هرع المسعفون برجل أصيب في حادث سيارة. كان قد كُسرت ساقه قبل وصوله، وكان وجهه مغطى بالدماء. سارعت الممرضات بنقله لإجراء أشعة سينية بينما استعدت الدكتورة مها لخياطة جرح عميق في جبهته. قال مدير غرفة الطوارئ بفخر: \"لقد أنقذه العمل الجماعي\". وفي الخارج، كانت السماء تمطر بغزارة شديدة عندما ركض الدكتور باسم إلى داخل المستشفى مبتلاً تماماً من رأسه لقدمه.",
                        vocabNotes: "rushed in (هرع مسرعاً) • car crash (حادث سيارة) • stitch (يخيط الجرح) • forehead (جبين) • raining cats and dogs (تمطر بغزارة) • soaked to the skin (مبتل تماماً)"
                    },
                    {
                        title: "Scene 2: Inside the ER Chaos & Calm Under Pressure",
                        imageUrl: "./sec 3 storybook photos/sec3_u1_l45_scene2_er_chaos.webp",
                        caption: "Bustling emergency room with beeping monitors and calm Nurse Noura directing sterile equipment",
                        textEn: "Inside, the emergency room was in full chaos — patients groaning, nurses hurrying, and machines beeping non-stop. In one corner, a teenager with a broken arm moaned quietly. A construction worker, pale as a ghost, clutched his bleeding hand, trying not to cry out. Nurse Noura, calm under pressure, gave clear and confident instructions. “Prepare the sterile equipment and state its condition before use”, she ordered.",
                        textAr: "في الداخل، كانت غرفة الطوارئ في حالة فوضى تامة — المرضى يتأوهون، والممرضات يهرعن، والآلات تصدر صفير تنبيه دون توقف. وفي إحدى الزوايا، كان مراهق ذو ذراع مكسورة يئن في هدوء. بينما عامل بناء، شاحب كالطيف من شدة الألم، أمسك بقوة بيده النازفة محاولاً ألا يصرخ. وقامت الممرضة نورا، الهادئة تحت الضغط، بإعطاء تعليمات واضحة وواثقة: \"جهزوا المعدات المعقمة واذكروا حالتها قبل الاستخدام\".",
                        vocabNotes: "chaos (فوضى) • groaning (يتأوه) • moaned (أنّ) • pale as a ghost (شاحب كالشبح) • clutched (أمسك بقوة) • sterile equipment (معدات معقمة) • under pressure (تحت الضغط)"
                    },
                    {
                        title: "Scene 3: Swallowed Coin & Flexible Scope Rescue",
                        imageUrl: "./sec 3 storybook photos/sec3_u1_l45_scene3_pediatric_scope.webp",
                        caption: "Pediatric emergency care: Doctor treating and comforting the toddler with mother present",
                        textEn: "Suddenly, the ER doors flew open. A panicked mother rushed in, holding her toddler. “He’s not responding!”, she shouted. The child had swallowed a coin. Without hesitation, the team jumped into action. Using a flexible scope, they carefully removed the coin. Moments later, the child opened his eyes. The mother wept with relief and gratitude. Around her, staff members smiled — some hiding their own tears.",
                        textAr: "وفجأة، فُتحت أبواب غرفة الطوارئ على مصراعيها. دخلت أم مذعورة مسرعة وهي تحمل طفلها الصغير وصرخت: \"إنه لا يستجيب!\". كان الطفل قد ابتلع عملة معدنية. وبدون أدنى تردد، انطلق الفريق في العمل بسرعة؛ وباستخدام منظار طبي مرن، استخرجوا العملة بحذر وعناية. بعد لحظات، فتح الطفل عينيه، وبكت الأم من الفرح والارتياح والعرفان بالجميل، وابتسم أفراد الطاقم حولها وأخفى بعضهم دموعه.",
                        vocabNotes: "panicked (مذعور) • swallowed a coin (ابتلع عملة) • without hesitation (دون تردد) • flexible scope (منظار مرن) • relief & gratitude (ارتياح وعرفان) • tears (دموع)"
                    },
                    {
                        title: "Scene 4: Sunrise Dawn & Life-Saving Teamwork",
                        imageUrl: "./sec 3 storybook photos/sec3_u1_l45_scene4_dawn_relief.webp",
                        caption: "Sunrise glowing through hospital windows as exhausted doctors review medical charts",
                        textEn: "As the sun began to rise, calm slowly returned. Dr. Basem sat down, exhausted. Around him, the team cleaned up and checked medical charts. Another night filled with fear, urgency, and life-saving teamwork had come to an end.",
                        textAr: "ومع بدء شروق الشمس، عاد الهدوء ببطء. جلس الدكتور باسم منهكاً من التعب. ومن حوله، قام الفريق بالتنظيف ومراجعة السجلات والملفات الطبية. لقد انتهت ليلة أخرى كانت مفعمة بالخوف، الضرورة الملحة، والعمل الجماعي المنقذ للحياة.",
                        vocabNotes: "exhausted (منهك) • medical charts (سجلات طبية) • urgency (ضرورة ملحة / طارئة) • life-saving teamwork (عمل جماعي منقذ للحياة) • come to an end (ينتهي)"
                    }
                ]
            },

            // Deck 2: My Blog Post (SB p. 23)
            {
                id: "my_blog_post",
                title: "📝 النص الثاني: مدونتي وتجربة نزلة البرد (My Unwelcome Visitor - SB p. 23)",
                pages: [
                    {
                        title: "Scene 1: An Unwelcome Visitor — Catching a Cold",
                        imageUrl: "./sec 3 storybook photos/sec3_u1_l45_scene5_cold_recovery.webp",
                        caption: "Patient resting at home suffering from severe cold symptoms and fatigue",
                        textEn: "Hello everyone! I want to share something that happened to me recently. About two weeks ago, I started to feel a little tired. I also had a small cough. I didn’t think it was very serious at first. But then, the symptoms got much worse. My throat was very sore, and my nose was running all the time. I also had a bad headache and felt very tired. It was difficult to sleep at night because of the cough. I felt really miserable and uncomfortable. After a few days, I decided I needed to see a doctor.",
                        textAr: "مرحباً بالجميع! أود أن أشارككم أمراً حدث لي مؤخراً. منذ حوالي أسبوعين، بدأت أشعر ببعض التعب، وكان لدي سعال خفيف. لم أكن أعتقد أن الأمر خطير في البداية. لكن بعد ذلك، ازدادت الأعراض سوءاً بكثير؛ صار حلقي ملتهباً للغاية، وكان أنفي يسيل طوال الوقت، كما أصبت بصداع شديد وشعرت بإرهاق بالغ. كان من الصعب النوم ليلاً بسبب السعال. شعرت بالبؤس الشديد وعدم الراحة، وبعد بضعة أيام، قررت أنني بحاجة لرؤية الطبيب.",
                        vocabNotes: "unwelcome visitor (زائر غير مرغوب) • cough (سعال) • symptoms (أعراض) • sore throat (حلق ملتهب) • miserable (بائس - تعيس) • appointment (موعد)"
                    },
                    {
                        title: "Scene 2: Clinic Visit, Stethoscope & Medical Advice",
                        imageUrl: "./sec 3 storybook photos/sec3_u1_l45_scene6_clinic_doctor.webp",
                        caption: "Doctor examining chest with stethoscope and issuing prescription for recovery",
                        textEn: "So, I called my clinic and made an appointment. When I arrived, the waiting room was full of other people who also looked sick. After a short wait, the doctor called my name. He asked me many questions about my symptoms and how long I had felt bad. Then, he checked my throat, listened to my chest with a stethoscope, and took my temperature. He said I had a severe viral cold. The doctor gave me a prescription for some medicine to help with the symptoms. He also told me to rest a lot and drink many warm liquids like tea. I went home, took the medicine, and tried to sleep as much as possible. Slowly, after about three or four days, I started to feel much better.",
                        textAr: "لذا، اتصلت بعيادتي وحجزت موعداً. وعندما وصلت، كانت غرفة الانتظار ممتلئة بأشخاص آخرين بدت عليهم علامات المرض أيضاً. بعد انتظار قصير، نادى الطبيب اسمي؛ وسألني أسئلة كثيرة عن أعراضي وكم من الوقت شعرت بالسوء. ثم فحص حلقي، واستمع إلى صدري بالسماعة الطبية، وقاس درجة حرارتي. وقال إنني مصاب بنزلة برد فيروسية حادة. أعطاني الطبيب وصفة طبية لبعض الأدوية، ونصحني بالراحة التامة وشرب الكثير من السوائل الدافئة كالشاي. ذهبت للمنزل، وتناولت الدواء، ونمت قدر الإمكان. وتدريجياً، بعد 3 أو 4 أيام، بدأت أشعر بتحسن كبير.",
                        vocabNotes: "appointment (موعد) • stethoscope (سماعة الطبيب) • temperature (درجة الحرارة) • viral cold (نزلة برد فيروسية) • prescription (روشتة دواء) • warm liquids (سوائل دافئة)"
                    },
                    {
                        title: "Scene 3: Health Restored & Interactive Call to Action",
                        imageUrl: "./sec 3 storybook photos/sec3_u1_l45_scene7_recovered_blogger.webp",
                        caption: "Healthy blogger happy and recovered, writing reflections on laptop",
                        textEn: "Now, I am healthy again, and I feel very happy about it! This experience reminded me how important our health is. It’s also good to know that doctors are there to help us when we need them. Have you ever had a very bad cold? How do you usually recover? Let me know in the comments!",
                        textAr: "والآن، أصبحت بصحة جيدة مرة أخرى، وأشعر بسعادة غامرة حيال ذلك! لقد ذكرتني هذه التجربة بمدى أهمية صحتنا. كما أنه من الرائع معرفة أن الأطباء متواجدون دائماً لمساعدتنا عند الحاجة. هل أصبت من قبل بنزلة برد شديدة؟ وكيف تتعافى منها عادةً؟ شاركوني تجاربكم في التعليقات!",
                        vocabNotes: "healthy again (معافى وبصحة) • reminded me (ذكرني) • recover (يتعافى) • call to action (دعوة للمشاركة بالتعليقات)"
                    }
                ]
            }
        ];

        // Active Storybook Controller
        window.activeDeckIndex = 0;
        window.currentStoryPageIndex = 0;

        window.selectStoryDeck = function(deckIdx) {
            window.activeDeckIndex = deckIdx;
            window.currentStoryPageIndex = 0;
            const deck = window.readingDecks[deckIdx];
            if (!deck) return;

            // Update Deck switcher button badges
            for (let i = 0; i < window.readingDecks.length; i++) {
                const btn = document.getElementById('storyTabBtn-' + i);
                if (btn) {
                    if (i === deckIdx) {
                        btn.className = 'badge badge-active story-select-btn';
                        btn.style.opacity = '1';
                    } else {
                        btn.className = 'badge badge-gold story-select-btn';
                        btn.style.opacity = '0.7';
                    }
                }
            }

            const meta = document.getElementById('storyDeckMeta');
            if (meta) meta.textContent = deck.title;

            if (window.storyEngine) {
                window.storyEngine.loadPages(deck.pages);
            } else {
                renderStoryPageUI();
            }
            if (typeof window.playSound === 'function') window.playSound('click');
        };

        function renderStoryPageUI() {
            const deck = window.readingDecks[window.activeDeckIndex];
            if (!deck || !deck.pages) return;
            const page = deck.pages[window.currentStoryPageIndex];
            if (!page) return;

            const badge = document.getElementById('storyPageBadge');
            const img = document.getElementById('storyArtworkImg');
            const caption = document.getElementById('storyCaption');
            const meta = document.getElementById('storyDeckMeta');
            const counter = document.getElementById('storyPageCounter');
            const title = document.getElementById('storyTitle');
            const text = document.getElementById('storyText');
            const trans = document.getElementById('storyTranslation');
            const vocab = document.getElementById('storyVocab');
            const prevBtn = document.getElementById('storyPrevBtn');
            const nextBtn = document.getElementById('storyNextBtn');
            const progressText = document.getElementById('storyPageProgressText');
            const dotsContainer = document.getElementById('storyProgressDots');

            if (badge) badge.textContent = `🖼️ Scene ${window.currentStoryPageIndex + 1} of ${deck.pages.length}`;
            if (img) {
                img.src = page.imageUrl;
                img.classList.remove('hidden');
            }
            if (caption) caption.textContent = page.caption;
            if (meta) meta.textContent = deck.title;
            if (counter) counter.textContent = `Page ${window.currentStoryPageIndex + 1} / ${deck.pages.length}`;
            if (title) title.textContent = page.title;
            if (text) text.innerHTML = page.textEn;
            if (trans) trans.innerHTML = `<span class="translation-tag">💡 الترجمة المعتمدة:</span> ${page.textAr}`;
            
            if (vocab) {
                const notes = page.vocabNotes.split('•');
                vocab.innerHTML = notes.map(n => `<span class="vocab-chip">${n.trim()}</span>`).join(' ');
            }

            if (prevBtn) prevBtn.disabled = (window.currentStoryPageIndex === 0);
            if (nextBtn) nextBtn.disabled = (window.currentStoryPageIndex === deck.pages.length - 1);
            if (progressText) progressText.textContent = `Scene ${window.currentStoryPageIndex + 1} of ${deck.pages.length}`;

            if (dotsContainer) {
                dotsContainer.innerHTML = '';
                for (let i = 0; i < deck.pages.length; i++) {
                    const dot = document.createElement('span');
                    dot.className = 'dot' + (i === window.currentStoryPageIndex ? ' active' : '');
                    dotsContainer.appendChild(dot);
                }
            }
        }

        window.changeStoryPage = function(delta) {
            const deck = window.readingDecks[window.activeDeckIndex];
            if (!deck) return;
            const newIdx = window.currentStoryPageIndex + delta;
            if (newIdx >= 0 && newIdx < deck.pages.length) {
                window.currentStoryPageIndex = newIdx;
                if (window.storyEngine) {
                    window.storyEngine.changePage(delta);
                } else {
                    renderStoryPageUI();
                }
                if (typeof window.playSound === 'function') window.playSound('click');
            }
        };

        window.speakCurrentStoryPage = function(btn) {
            const deck = window.readingDecks[window.activeDeckIndex];
            if (!deck) return;
            const page = deck.pages[window.currentStoryPageIndex];
            if (page && typeof window.speakText === 'function') {
                window.speakText(page.textEn);
                if (typeof window.playSound === 'function') window.playSound('click');
            }
        };

        let isStorytelling = false;
        let storytellerTimer = null;
        window.toggleStoryteller = function() {
            if (window.storyEngine) {
                window.storyEngine.toggleStoryteller();
                return;
            }
            const btn = document.getElementById('storytellerBtn');
            const deck = window.readingDecks[window.activeDeckIndex];
            if (!deck) return;

            if (isStorytelling) {
                isStorytelling = false;
                clearTimeout(storytellerTimer);
                if (window.speechSynthesis) window.speechSynthesis.cancel();
                if (btn) {
                    btn.classList.remove('active');
                    btn.textContent = '▶️ القارئ التلقائي (Auto Storyteller)';
                }
            } else {
                isStorytelling = true;
                if (btn) {
                    btn.classList.add('active');
                    btn.textContent = '⏹️ إيقاف القارئ التلقائي';
                }
                playStorytellerStep();
            }
        };

        function playStorytellerStep() {
            if (!isStorytelling) return;
            const deck = window.readingDecks[window.activeDeckIndex];
            if (!deck) return;
            const page = deck.pages[window.currentStoryPageIndex];
            if (!page) return;

            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance(page.textEn);
                utter.lang = 'en-US';
                utter.rate = 0.9;
                utter.onend = () => {
                    if (!isStorytelling) return;
                    if (window.currentStoryPageIndex < deck.pages.length - 1) {
                        storytellerTimer = setTimeout(() => {
                            window.changeStoryPage(1);
                            playStorytellerStep();
                        }, 2000);
                    } else {
                        window.toggleStoryteller();
                    }
                };
                utter.onerror = () => {
                    if (isStorytelling) window.toggleStoryteller();
                };
                window.speechSynthesis.speak(utter);
            }
        }

        // ==========================================
        // 2. Linked Expression Gallery Controller (6 Items)
        // ==========================================
        const expressionsData = [
            {
                id: 1,
                en: "pale as a ghost",
                ar: "شديد الشحوب / باهت (من الخوف أو المرض)",
                img: "../../assets/images/pale_as_a_ghost.webp",
                explain: "شحوب الوجه الشديد والمفاجئ نتيجة الخوف الشديد، الصدمة العصبية، أو النزيف والألم.",
                exampleEn: "A construction worker, <strong style='color: var(--accent-primary);'>pale as a ghost</strong>, clutched his bleeding hand, trying not to cry out.",
                exampleAr: "عامل بناء، شاحب كالشبح، أمسك بيده النازفة محاولاً ألا يصرخ من الألم."
            },
            {
                id: 2,
                en: "rain cats and dogs",
                ar: "تمطر بغزارة شديدة",
                img: "../../assets/images/rain_cats_and_dogs.webp",
                explain: "تعبير مجازي شهير يصف هطول الأمطار بغزارة طوفانية شديدة.",
                exampleEn: "Outside, it was <strong style='color: var(--accent-primary);'>raining cats and dogs</strong> as Dr. Basem ran into the hospital.",
                exampleAr: "في الخارج، كانت السماء تمطر بغزارة شديدة عندما ركض الدكتور باسم للمستشفى."
            },
            {
