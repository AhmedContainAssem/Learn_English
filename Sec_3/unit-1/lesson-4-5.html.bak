        };
        window.quizData = window.lessonData;

        document.addEventListener('DOMContentLoaded', () => {
            if (window.selectStoryDeck) {
                window.selectStoryDeck(0);
            }
            if (window.quizEngine && window.lessonData && window.lessonData.quiz) {
                window.quizEngine.loadQuestions(window.lessonData.quiz);
            }
        });
    </script>

