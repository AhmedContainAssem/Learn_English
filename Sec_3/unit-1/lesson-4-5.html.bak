                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <div class="word-en" style="color: var(--accent-primary);">swallow(ed) (v)</div>
                        <span class="tag-badge">يبتلع</span>
                    </div>
                    <div class="card-body">
